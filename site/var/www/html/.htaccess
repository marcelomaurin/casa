# CASA/JARVIS publicado em https://maurinsoft.com.br/casa/
# A entrada pelo diretorio passa primeiro pelo login. Se a sessao ja estiver
# autenticada, login.php redireciona para /casa/index.php.
DirectoryIndex login.php index.php

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /casa/

# Mantem chamadas diretas a arquivos e diretorios existentes.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>

# Aplica a camada visual LCARS apenas ao dashboard principal sem alterar
# a logica PHP/JavaScript existente em index.php.
<IfModule mod_substitute.c>
  <Files "index.php">
    AddOutputFilterByType SUBSTITUTE text/html
    Substitute "s|</head>|<link rel='stylesheet' href='/casa/lcars.css?v=20260914'></head>|ni"
    Substitute "s|/login.php?logout=1|/casa/login.php?logout=1|ni"
  </Files>
</IfModule>
