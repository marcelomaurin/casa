# CASA/JARVIS - entrada principal
# O index.php e a interface LCARS adaptativa oficial e redireciona para
# /casa/login.php quando nao existe sessao autenticada.
DirectoryIndex index.php login.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /casa/

# Mantem acesso direto aos arquivos e diretorios existentes.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>
