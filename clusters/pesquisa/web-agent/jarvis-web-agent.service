[Unit]
Description=JARVIS - Agente de Pesquisa na Internet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/jarvis-web-agent
EnvironmentFile=-/etc/jarvis/web-agent.env
ExecStart=/opt/jarvis-web-agent/venv/bin/python /opt/jarvis-web-agent/web_agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
