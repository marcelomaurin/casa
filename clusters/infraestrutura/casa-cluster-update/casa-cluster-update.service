[Unit]
Description=CASA - atualiza os integradores a partir do Git (branch master)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/casa/cluster-update
ExecStart=/usr/bin/python3 /opt/casa/cluster-update/casa-cluster-update.py --apply
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
UMask=0077
