[Unit]
Description=CASA Cluster Update Service - Git Sync and Services Reload
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/casa/cluster-update
ExecStart=/usr/bin/python3 /opt/casa/cluster-update/casa-cluster-update.py --apply
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
