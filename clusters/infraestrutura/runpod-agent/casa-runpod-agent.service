[Unit]
Description=Servico Agente RunPod e SSH - Casa Inteligente
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/casa/servicos/runpod-agent
ExecStart=/usr/bin/python3 /opt/casa/servicos/runpod-agent/casa-runpod-agent.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
