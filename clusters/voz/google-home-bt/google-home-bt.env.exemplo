# Configuracao da Ponte Bluetooth com Google Home (casa-google-home-bt)
CASA_GH_BT_HOST=0.0.0.0
CASA_GH_BT_PORT=8094

# Endereco MAC Bluetooth do Google Home / Nest Mini (exemplo: 20:DF:B9:AA:BB:CC)
CASA_GH_BT_TARGET_MAC=
CASA_GH_BT_TARGET_NAME=Google Home

# Daemons auxiliares locais
CASA_PARAKEET_URL=http://127.0.0.1:8092
CASA_POCKET_TTS_URL=http://127.0.0.1:8093
CASA_ORQUESTRADOR_URL=http://127.0.0.1:8090

# Parametros operacionais
CASA_GH_BT_LISTEN_SEC=6
CASA_GH_BT_AUTO_RECONNECT=1

