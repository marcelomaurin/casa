# Copiar para /etc/casa/sip-agent.env; lido pelo systemd.
CASA_SIP_BIND=0.0.0.0
CASA_SIP_PORT=5060
CASA_SIP_RTP_PORT=42000
CASA_SIP_PUBLIC_ADDRESS=
CASA_SIP_REALM=casa.local
CASA_SIP_EXTENSION=8000
CASA_SIP_DIGEST=sha256
CASA_SIP_USERS_FILE=/etc/casa/sip-users.ini
CASA_SIP_LIBRARY=/opt/casa/servicos/sip-agent/libchatgpt_sip_bridge.so
CASA_SIP_MAX_CALLS=4
CASA_SIP_ENERGY_THRESHOLD=500
CASA_SIP_MIN_SPEECH_MS=200
CASA_SIP_SILENCE_MS=700
CASA_SIP_MAX_UTTERANCE_MS=15000
# Deve apontar para um motor de reconhecimento real, nao uma demonstracao.
CASA_SIP_STT_URL=http://127.0.0.1:8092/transcribe
CASA_SIP_STT_TOKEN=
CASA_SIP_TTS_URL=http://127.0.0.1:8097/falar
CASA_SIP_AUDIO_BASE_URL=http://127.0.0.1:8097/audio/
CASA_SIP_TTS_TOKEN=
CASA_SIP_SPEAKER=padrao
CASA_SIP_HTTP_TIMEOUT_MS=30000
# Usa o nucleo JARVIS e o Command Bus oficial para comandos da casa.
CASA_SIP_AI_FORMAT=casa
CASA_SIP_AI_URL=https://maurinsoft.com.br/casa/api/v1/comando
CASA_SIP_AI_TOKEN=
# Alternativa para conversa com LLM local: openai-compatible e /v1/chat/completions.
CASA_SIP_AI_MODEL=
