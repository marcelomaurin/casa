# Arquivo de exemplo; manter credenciais reais somente em /etc/casa/google-home-agent.env.
CASA_BASE_URL=https://maurinsoft.com.br/casa
CASA_TAREFAS_CHAVE=PREENCHER_CREDENCIAL_TASKS_WORKER
CASA_GOOGLE_HOME_API_TOKEN=PREENCHER_CHAVE_LOCAL
CASA_GOOGLE_HOME_PUBLIC_BASE_URL=http://192.168.2.13:8100
# Preencher depois com nome exato/UUID e IP do Google Home.
CASA_GOOGLE_HOME_DEFAULT_DEVICE=
CASA_GOOGLE_HOME_KNOWN_HOSTS=
CASA_TAREFAS_WORKER_FILE=/opt/casa-tarefas/casa-tarefas.py
