# Configuracao do Daemon Pocket-TTS (Sintese de Voz Leve)
# Copie para /etc/casa/pocket-tts.env ou /etc/casa-pocket-tts.env

POCKET_TTS_HOST=0.0.0.0
POCKET_TTS_PORT=8093
POCKET_TTS_DEFAULT_VOICE=jarvis
POCKET_TTS_SAMPLE_RATE=22050
POCKET_TTS_AUDIO_DIR=/var/lib/casa-pocket-tts/audios

# Integracao com a API central do CASA (somente /api/v1/)
CASA_BASE_URL=https://maurinsoft.com.br/casa
JARVIS_DEVICE_TOKEN=
