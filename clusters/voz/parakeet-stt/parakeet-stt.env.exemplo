# Configuracao do Daemon Parakeet STT (Reconhecimento de Voz Local)
# Copie para /etc/casa/parakeet-stt.env ou /etc/casa-parakeet-stt.env

PARAKEET_STT_HOST=0.0.0.0
PARAKEET_STT_PORT=8092
PARAKEET_STT_DEVICE=cpu
PARAKEET_STT_MODEL=nvidia/parakeet-tdt-0.6b-pt
PARAKEET_STT_MODEL_PATH=
PARAKEET_STT_TEMP_DIR=/var/lib/casa-parakeet-stt/tmp

# Integracao com a API central do CASA (somente /api/v1/)
CASA_BASE_URL=https://maurinsoft.com.br/casa
JARVIS_DEVICE_TOKEN=
