# /etc/casa-tarefas.env — configuração do daemon casa-tarefas
# Endereço do site CASA (o daemon usa só /api/v1).
CASA_BASE_URL=https://maurinsoft.com.br/casa

# Chave de cliente da API v1, criada no painel em Acesso Web & API, com os escopos:
#   tasks.worker    (obrigatório: pegar e devolver tarefas)
#   jarvis.command  (necessário para o executor "jarvis")
CASA_TAREFAS_CHAVE=

# Nome deste nó na fila. Tarefas com fila = este nome só vão para ele.
# CASA_TAREFAS_NOME=pi-sala

# Executores que este nó oferece: jarvis, web, fala, comando e os das extensões.
CASA_TAREFAS_EXECUTORES=jarvis,web,fala

# Filas extras atendidas além de "geral" e do próprio nome (separadas por vírgula).
# CASA_TAREFAS_FILAS=

# Tarefas ao mesmo tempo, espera entre consultas (s) e prazo da reserva (s).
CASA_TAREFAS_PARALELO=2
CASA_TAREFAS_INTERVALO=5
CASA_TAREFAS_PRAZO=300

# Tempo máximo de um script do executor "comando" (s).
CASA_TAREFAS_TEMPO_LIMITE=240

# Serviços locais reaproveitados.
CASA_TTS_URL=http://127.0.0.1:8097/falar
CASA_WEB_AGENT_URL=http://127.0.0.1:8099/search

# Scripts autorizados (executor "comando") e extensões em Python.
CASA_TAREFAS_COMANDOS_DIR=/etc/casa-tarefas/comandos.d
CASA_TAREFAS_EXTENSOES_DIR=/opt/casa-tarefas/executores

# DEBUG, INFO, WARNING ou ERROR
CASA_TAREFAS_LOG=INFO

# Mordomo: segundos entre ciclos (detectar, decidir, avisar/agir). 0 desliga neste nó.
# Pode ficar ligado em vários nós: o site garante um ciclo por vez.
CASA_MORDOMO_INTERVALO=60
