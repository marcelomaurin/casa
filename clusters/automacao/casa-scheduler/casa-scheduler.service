[Unit]
Description=JARVIS - Agendador de Tarefas Automatizadas da Residencia
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/casa-scheduler
ExecStart=/usr/bin/python3 /opt/casa-scheduler/casa-scheduler.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
