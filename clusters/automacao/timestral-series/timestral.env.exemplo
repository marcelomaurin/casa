# Configuracao do Daemon Timestral-5M (Series Temporais e Forecasting)
# Copie para /etc/casa/timestral.env ou /etc/casa-timestral.env

TIMESTRAL_HOST=0.0.0.0
TIMESTRAL_PORT=8091
TIMESTRAL_DEVICE=cpu
TIMESTRAL_MODEL=timestral-5m-residential
TIMESTRAL_MODEL_PATH=
TIMESTRAL_MAX_HORIZON=96
TIMESTRAL_ANOMALY_SENSITIVITY=2.5

# Integracao com a API central do CASA (somente /api/v1/)
CASA_BASE_URL=https://maurinsoft.com.br/casa
JARVIS_DEVICE_TOKEN=
