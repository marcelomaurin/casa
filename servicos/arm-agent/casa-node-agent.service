[Unit]
Description=Casa Inteligente - Agente Distribuido para Nos ARM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/casa-node-agent
ExecStart=/usr/bin/python3 /opt/casa-node-agent/casa-node-agent.py
Restart=always
RestartSec=10
Environment="JARVIS_MASTER_URL=https://casa.maurinsoft.com.br/api/crud.php"
Environment="AGENT_PORT=8098"
Environment="HEARTBEAT_INTERVAL=20"
EnvironmentFile=-/etc/casa-node-agent.env

[Install]
WantedBy=multi-user.target
